# =============================================================================
# Punto Madera — variables de entorno
#
# Copiá este archivo a `.env.local` y completá los valores.
# `.env.local` está en .gitignore: no se versiona jamás.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
# En local, `supabase start` imprime estos dos valores.
# En producción están en el panel de Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# La clave de servicio NUNCA lleva el prefijo NEXT_PUBLIC_ ni se usa desde el
# navegador: elude la RLS por completo. Solo hace falta para tareas de
# administración fuera de la aplicación (semilla, migraciones de datos).
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Base local para migraciones y pruebas de base de datos
# -----------------------------------------------------------------------------
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=punto_madera

# -----------------------------------------------------------------------------
# Pruebas end-to-end
# -----------------------------------------------------------------------------
# Si se define, Playwright usa esa URL en lugar de levantar el servidor.
# E2E_BASE_URL=http://127.0.0.1:3000
E2E_OWNER_EMAIL=dueno@puntomadera.test
E2E_OWNER_PASSWORD=punto-madera-demo
E2E_EMPLOYEE_EMAIL=empleado@puntomadera.test
E2E_EMPLOYEE_PASSWORD=punto-madera-demo
